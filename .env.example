# bim-assistant — variables de entorno para el PoC.
#
# Copia este archivo a `.env.local` y rellena las claves reales:
#   cp .env.example .env.local
#
# Las claves se embeben en el bundle del cliente (VITE_* se reemplaza
# en build). Esto es aceptable para el PoC interno de SalfaCorp —
# si necesitas exponerlo públicamente, monta un proxy de Cloud
# Functions antes. (Para v1.x, ver PROJECT-TRACKER.md.)

# Google AI Studio / Gemini API key
# Obtener en https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_key_here

# Fireworks AI API key
# Obtener en https://fireworks.ai/account/api-keys
VITE_FIREWORKS_API_KEY=your_fireworks_key_here
